# หน้า install.php สร้างไฟล์ .env ให้โดยอัตโนมัติ ไฟล์นี้ใช้ดูว่ามีค่าอะไรให้ตั้งได้บ้าง

# การเชื่อมต่อ MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tabhub

# (ไม่บังคับ) ที่อยู่เว็บจริง ใช้ทำลิงก์แชร์ตาราง
# PUBLIC_URL=http://timetable.example.ac.th/tabhub/

# (ไม่บังคับ) ตั้งเป็น true เฉพาะเมื่อมี reverse proxy เช่น nginx อยู่ข้างหน้า
# TRUST_PROXY=true

# (ไม่บังคับ) คีย์ API ของระบบ TAB เดิม สำหรับปุ่ม "นำเข้าจาก TAB"
# TAB_API_KEY=
